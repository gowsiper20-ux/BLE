PORT=3000
DATABASE_URL=postgres://postgres:your_local_password@localhost:5432/smart_attendance
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
MICROSOFT_TENANT_ID=a5bd300c-c3b3-41d8-87e0-1f5c8d364af3
MICROSOFT_CLIENT_ID=adb61c0d-61e2-4b89-a8fa-b27726a32e9c
MICROSOFT_CLIENT_SECRET=
# For v2 access tokens, aud is the backend API application's client-ID GUID, not its api:// scope URI.
MICROSOFT_API_AUDIENCE=adb61c0d-61e2-4b89-a8fa-b27726a32e9c
# Scope claim value emitted in the backend API access token (for example: access_as_user).
MICROSOFT_API_SCOPE=access_as_user
# Set only after the tenant administrator verifies these group IDs and approves direct-membership semantics.
MICROSOFT_GROUP_MEMBERSHIP_MODE=
MICROSOFT_IT_STUDENT_GROUP_IDS=
MICROSOFT_IT_STAFF_GROUP_IDS=
# Graph application permissions required by the current sync requests include User.Read.All and GroupMember.Read.All.
# A tenant administrator must grant application permissions and admin consent on the confidential Graph client.
# Only IT student and IT staff group classification is implemented; no ADMIN/HOD/DEPUTY_HOD group-role mapping exists.
# Optional Graph user property names. Configure only when these attributes are authoritative for academics.
MICROSOFT_BATCH_ATTRIBUTE=
MICROSOFT_CLASS_ATTRIBUTE=
COLLEGE_EMAIL_DOMAIN=sonatech.ac.in
# Opt-in single-process scheduler interval; 0 disables scheduled sync.
MICROSOFT_SYNC_INTERVAL_MINUTES=0
